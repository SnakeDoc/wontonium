{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "useEditorconfig": true
  },
  "linter": {
    "rules": {
      "preset": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "recommended": true
      }
    }
  }
}
