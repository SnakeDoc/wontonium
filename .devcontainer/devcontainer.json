// For format details, see https://aka.ms/devcontainer.json.
{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.schema.json",
  "name": "wonton",
  "image": "ghcr.io/snakedoc/wontonium/devcontainer:latest@sha256:8a1a5b0e013acd7a58148c0650d921e95b8f1b5e923fc5408125895a1df97f0f",
  "runArgs": ["--security-opt=label=disable", "--userns=keep-id"],
  "mounts": [
    "source=${localWorkspaceFolderBasename}-fish-cache,target=/home/wonton/.local/share/fish,type=volume"
  ],
  "postCreateCommand": "mise install",
  "containerEnv": {
    "ASTRO_TELEMETRY_DISABLED": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "astro-build.astro-vscode",
        "biomejs.biome",
        "bmalehorn.vscode-fish",
        "bradgashler.htmltagwrap",
        "bradlc.vscode-tailwindcss",
        "christian-kohler.path-intellisense",
        "davidanson.vscode-markdownlint",
        "donjayamanne.githistory",
        "editorconfig.editorconfig",
        "formulahendry.auto-close-tag",
        "formulahendry.auto-rename-tag",
        "foxundermoon.shell-format",
        "github.codespaces",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "hono.hono",
        "mhutchie.git-graph",
        "ms-azuretools.vscode-docker",
        "ms-vsliveshare.vsliveshare",
        "openai.chatgpt",
        "redhat.vscode-yaml",
        "redocly.openapi-vs-code",
        "ritwickdey.liveserver",
        "stylelint.vscode-stylelint",
        "typespec.typespec-vscode",
        "vitest.explorer",
        "wallabyjs.console-ninja",
        "wallabyjs.wallaby-vscode",
        "wallabyjs.quokka-vscode",
        "yoavbls.pretty-ts-errors",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        // TypeSpec server path
        "typespec.tsp-server.path": "${workspaceFolder}/apps/contract/node_modules/@typespec/compiler/cmd/tsp-server.js",

        // editor fonts & ligatures
        "editor.fontFamily": "'Symbols Nerd Font Mono','Fira Code','Cascadia Code','JetBrains Mono','Droid Sans Mono','monospace',monospace",
        "editor.fontLigatures": true,

        // terminal fonts
        "terminal.integrated.fontFamily": "'Symbols Nerd Font Mono','Fira Code','Cascadia Code','JetBrains Mono','monospace'",

        // save behavior
        "files.autoSave": "afterDelay",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit",
          "source.fixAll": "explicit"
        },

        // formatting / whitespace
        "editor.defaultFormatter": "biomejs.biome",
        "editor.tabSize": 2,
        "editor.rulers": [
          { "column": 100, "color": "#80808022" },
          { "column": 120, "color": "#80808055" }
        ],
        "editor.renderWhitespace": "selection",
        "editor.formatOnPaste": true,
        "editor.linkedEditing": true,

        // git / scm
        "git.confirmSync": true,
        "git.autofetch": true,

        // copilot
        "github.copilot.nextEditSuggestions.enabled": true
      }
    }
  }
}
